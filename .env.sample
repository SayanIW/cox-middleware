# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 Inventory (JSON source)
S3_BUCKET=your-bucket-name
S3_INVENTORY_KEY=inventory/vehicles.json

# Jarrett vendor-drop inventory (CSV, auto-selects latest jarrett_inventory_YYYY-MM-DD.csv)
# Uses the same S3_BUCKET. No extra key needed — the latest file is resolved automatically.

# Server
PORT=3000

# VinSolutions / Cox Automotive API credentials
VINSOLUTIONS_CLIENT_ID=your_client_id
VINSOLUTIONS_CLIENT_SECRET=your_client_secret
LEAD_SUBMISSIONS_API_KEY=your_lead_submissions_api_key
DIGITAL_SHOWROOM_API_KEY=your_digital_showroom_api_key

